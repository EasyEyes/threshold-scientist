{
  "rules": {
    ".read": false,
    ".write": false,
    "currentVersion": {
      ".read": true,
      ".write": false
    },
    "versions": {
      "$version": {
        "glossary": {
          ".read": true,
          ".write": false
        }
      }
    },
    "phrases": {
      "currentVersion": {
        ".read": true,
        ".write": false
      }
    },
    "phrasesVersions": {
      "$version": {
        "phrases": {
          ".read": true,
          ".write": false
        }
      }
    },
    "users": {
      "$username": {
        "$experimentName": {
          "glossaryVersion": {
            ".read": true,
            ".write": false
          },
          "phrasesVersion": {
            ".read": true,
            ".write": false
          }
        }
      }
    },
    "compiles": {
      "$id": {
        ".write": "newData.hasChildren(['id', 'user', 'timestamp', 'timeZone'])"
      }
    },
    "compileCounts": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "newData.isNumber()"
      }
    }
  }
}
