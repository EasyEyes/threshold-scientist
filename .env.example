FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_API_KEY_SOUND=your_firebase_api_key_sound_here
FIREBASE_DATABASE_URL=https://yout-firebase_url_here
# Sentry Error Tracking
# Get your DSN from: https://sentry.io/projects/[your-project]/keys/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=[optional]development|production
